{
  "name": "just-chess",
  "private": true,
  "version": "1.0.1",
  "description": "A no-nonsense pass-and-play chess board with a clock.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:android": "node scripts/android-dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "perft": "vitest run tests/perft.test.ts",
    "icons": "node scripts/build-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/gradle.mjs assembleRelease",
    "android:bundle": "npm run android:sync && node scripts/gradle.mjs bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "chess.js": "^1.4.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
